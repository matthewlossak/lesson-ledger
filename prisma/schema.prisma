generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum RateTier {
  REGULAR
  SENIOR
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  password       String
  name           String?
  students       Student[]
  // Invoice details — used to fill out exported invoices. All optional
  // since a tutor may not have set them up yet.
  abn            String?
  bsb            String?
  accountNumber  String?
  billToName     String?
  billToAddress  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Student {
  id              Int              @id @default(autoincrement())
  name            String
  subjects        String[]
  defaultRateTier RateTier         @default(REGULAR)
  userId          Int?
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions        SessionStudent[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Session {
  id          Int              @id @default(autoincrement())
  date        DateTime
  startTime   String?          // "HH:MM" 24h, e.g. "09:00" — null for legacy sessions
  duration    Decimal          // hours, e.g. 1.5
  rateCharged Decimal          // $/hr actually charged; auto-filled but editable
  note        String?          // free-text: what was covered
  students    SessionStudent[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// Join table — one Session can have many Students, one Student appears in many Sessions
model SessionStudent {
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId Int

  @@id([sessionId, studentId])
}
